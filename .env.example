# Copy this file to .env (project root) and fill in your key.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Gemini model used for answers.
GEMINI_MODEL=gemini-2.5-flash

# auto    = use Gemini when GEMINI_API_KEY is set, otherwise (or on Gemini errors) the offline extractive engine
# gemini  = Gemini only; return an HTTP error if Gemini is unavailable
# offline = never call Gemini (useful for demos without internet)
AI_MODE=auto

# Timeout for a single Gemini call, in seconds.
GEMINI_TIMEOUT_SECONDS=30

# Comma separated list of allowed origins, or * for any origin.
CORS_ORIGINS=*

LOG_LEVEL=INFO
